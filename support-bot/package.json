{
  "name": "mox-support-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Mox building support bot \u2014 Discord intake, Haiku triage, Notion mirror",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval": "tsx scripts/eval.ts",
    "register-commands": "tsx scripts/registerCommands.ts",
    "check-config": "tsx scripts/checkConfig.ts",
    "export-seed": "tsx scripts/exportSeed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
